# Bale Bot Token
BALE_TOKEN=your_bale_token_here

# Telegram API credentials (from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Telegram bot token for session management (from @BotFather)
SESSION_BOT_TOKEN=your_session_bot_token_here

# Admin Bale User ID (your numeric ID)
ADMIN_USER_ID=1575910263

# Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Cloudflare IDs (fill after creation)
D1_DATABASE_ID=
KV_NAMESPACE_ID=
